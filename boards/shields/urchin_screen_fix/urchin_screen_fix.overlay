// dongle_screen 모듈의 xiao_ble_zmk.overlay를 이 하드웨어에 맞게 보정한다.
// 반드시 dongle_screen 뒤에 오도록 실드 목록에 나열해야 한다.

// 이 XIAO의 D9 핀이 불량이라 SPI CS를 D2로 우회한다.
&spi3 {
    cs-gpios = <&xiao_d 2 GPIO_ACTIVE_LOW>;
};

&st7789 {
    // 15cm 듀폰선 + GND 1선이라 긴 픽셀 버스트가 깨질 수 있어 보수적으로 낮춤
    mipi-max-frequency = <1000000>;
};

// 광 센서 미사용. 모듈 오버레이가 int-gpios로 D2를 잡아 CS와 충돌한다.
// status="okay" 노드가 있으면 CONFIG_APDS9960이 자동으로 켜지므로
// .conf로는 막을 수 없고 노드를 여기서 꺼야 한다.
&apds9960 {
    status = "disabled";
};
